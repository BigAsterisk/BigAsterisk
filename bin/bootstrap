#!/bin/sh
# Fetches the project-local toolchain into tools/ so builds do not depend on the
# host's JDK, sbt or Spark installation. Safe to re-run: anything already present
# is left alone.
#
#   bin/bootstrap              # JDK 17 + sbt + Python 3.11 + Spark distribution
#   bin/bootstrap --no-spark   # skip the Spark distribution (~400 MB)
#
# Nothing is installed outside this repository.
set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TOOLS="$ROOT/tools"
JDK_VERSION=17
SBT_VERSION=1.10.7
SPARK_VERSION=4.1.2
PYTHON_VERSION=3.11.16
PYTHON_BUILD=20260814
HADOOP_PROFILE=hadoop3

WANT_SPARK=1
[ "$1" = "--no-spark" ] && WANT_SPARK=0

mkdir -p "$TOOLS"

case "$(uname -s)" in
  Darwin) OS=mac ;;
  Linux)  OS=linux ;;
  *) echo "Unsupported OS: $(uname -s). Install JDK $JDK_VERSION and sbt $SBT_VERSION manually." >&2; exit 1 ;;
esac
case "$(uname -m)" in
  x86_64|amd64) ARCH=x64 ;;
  arm64|aarch64) ARCH=aarch64 ;;
  *) echo "Unsupported architecture: $(uname -m)." >&2; exit 1 ;;
esac

# ---- JDK 17 -----------------------------------------------------------------
if [ -n "$(ls -d "$TOOLS"/jdk-17* 2>/dev/null)" ]; then
  echo "JDK $JDK_VERSION: already present"
else
  echo "JDK $JDK_VERSION: downloading ($OS/$ARCH)..."
  curl -fsSL -o "$TOOLS/jdk.tar.gz" \
    "https://api.adoptium.net/v3/binary/latest/${JDK_VERSION}/ga/${OS}/${ARCH}/jdk/hotspot/normal/eclipse"
  tar xzf "$TOOLS/jdk.tar.gz" -C "$TOOLS"
  rm -f "$TOOLS/jdk.tar.gz"
  echo "JDK $JDK_VERSION: installed"
fi

# ---- sbt --------------------------------------------------------------------
if [ -x "$TOOLS/sbt/bin/sbt" ]; then
  echo "sbt $SBT_VERSION: already present"
else
  echo "sbt $SBT_VERSION: downloading..."
  curl -fsSL -o "$TOOLS/sbt.tgz" \
    "https://github.com/sbt/sbt/releases/download/v${SBT_VERSION}/sbt-${SBT_VERSION}.tgz"
  tar xzf "$TOOLS/sbt.tgz" -C "$TOOLS"
  rm -f "$TOOLS/sbt.tgz"
  echo "sbt $SBT_VERSION: installed"
fi

# ---- Python -----------------------------------------------------------------
# PySpark 4.1 needs Python 3.10+: its sql/types.py evaluates PEP 604 unions
# (`int | None`) at import time, which 3.9 cannot parse. Rather than depend on the
# host having a new enough interpreter, fetch a standalone build.
if [ -x "$TOOLS/python/bin/python3" ]; then
  echo "Python $PYTHON_VERSION: already present"
else
  case "$OS" in
    mac)   PY_TRIPLE="$( [ "$ARCH" = aarch64 ] && echo aarch64-apple-darwin || echo x86_64-apple-darwin )" ;;
    linux) PY_TRIPLE="$( [ "$ARCH" = aarch64 ] && echo aarch64-unknown-linux-gnu || echo x86_64-unknown-linux-gnu )" ;;
  esac
  echo "Python $PYTHON_VERSION: downloading ($PY_TRIPLE)..."
  curl -fsSL -o "$TOOLS/python.tar.gz" \
    "https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_BUILD}/cpython-${PYTHON_VERSION}+${PYTHON_BUILD}-${PY_TRIPLE}-install_only.tar.gz"
  tar xzf "$TOOLS/python.tar.gz" -C "$TOOLS"
  rm -f "$TOOLS/python.tar.gz"
  echo "Python $PYTHON_VERSION: installed"
fi

# ---- Spark distribution -----------------------------------------------------
# Needed by the local-cluster test suites, which launch real executor JVMs through
# Spark's launcher, and by the PySpark tests.
SPARK_DIR="$TOOLS/spark-${SPARK_VERSION}-bin-${HADOOP_PROFILE}"
if [ "$WANT_SPARK" = "0" ]; then
  echo "Spark $SPARK_VERSION: skipped (--no-spark); local-cluster and PySpark tests will not run"
elif [ -d "$SPARK_DIR" ]; then
  echo "Spark $SPARK_VERSION: already present"
else
  echo "Spark $SPARK_VERSION: downloading (~400 MB)..."
  curl -fsSL -o "$TOOLS/spark.tgz" \
    "https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-${HADOOP_PROFILE}.tgz"
  tar xzf "$TOOLS/spark.tgz" -C "$TOOLS"
  rm -f "$TOOLS/spark.tgz"
  echo "Spark $SPARK_VERSION: installed"
fi

echo
echo "Toolchain ready in tools/. Next:"
echo "    bin/sbt test           # Scala suites, including local-cluster mode"
echo "    python/tests/run.sh    # PySpark end-to-end"
