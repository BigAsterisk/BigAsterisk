#!/bin/sh
# Launcher for the BigAsterisk tool CLI. Runs java directly rather than through sbt so
# stdin connects to the interactive menu, and pins the project-local JDK 17 plus the
# module opens Spark 4 needs.
#
#   bin/bigasterisk analyze --help  # run any tool against your own query and data
#   bin/bigasterisk tour            # every tool, on one small dataset, in one run
#   bin/bigasterisk                 # interactive BigSift menu
#   bin/bigasterisk weather max     # one-shot: run a BigSift scenario with an oracle
#
# Environment:
#   BIGASTERISK_HEAP   JVM heap for the driver (default 6g)
#   BIGSIFT_ROWS       rows per generated demo dataset (default 1,000,000)
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

JDK="$(ls -d "$ROOT"/tools/jdk-17* 2>/dev/null | head -1)"
if [ -z "$JDK" ]; then
  echo "No JDK 17 in tools/. Run bin/bootstrap first." >&2
  exit 1
fi
if [ -d "$JDK/Contents/Home" ]; then JAVA_HOME="$JDK/Contents/Home"; else JAVA_HOME="$JDK"; fi
export JAVA_HOME

MAIN=org.bigasterisk.examples.BigSiftCLI
case "$1" in
  # The tour runs on the small committed dataset and needs no generated data.
  tour)
    MAIN=org.bigasterisk.examples.PlatformTour
    shift
    SKIP_DEMO_DATA=1
    ;;
  # The general entry point: your query, your data, any tool. Reads nothing of its own,
  # so no demo data is generated for it either.
  analyze)
    MAIN=org.bigasterisk.examples.Analyze
    shift
    SKIP_DEMO_DATA=1
    ;;
esac

# Generate the demo datasets on first run.
if [ -z "$SKIP_DEMO_DATA" ] && { [ ! -f "$ROOT/examples/data/airport.csv" ] \
   || [ ! -f "$ROOT/examples/data/weather.csv" ] \
   || [ ! -f "$ROOT/examples/data/student.txt" ]; }; then
  PY="${PYSPARK_PYTHON:-$(command -v python3)}"
  if [ -z "$PY" ]; then
    echo "python3 is needed to generate the demo datasets." >&2
    exit 1
  fi
  "$PY" "$ROOT/examples/data/generate.py" "${BIGSIFT_ROWS:-1000000}" >&2
fi

# Cache the runtime classpath; sbt is slow to start, and this runs on every invocation.
CPFILE="$ROOT/examples/target/bigasterisk.classpath"
NEWER=$(find "$ROOT/examples/src" "$ROOT/modules" -name '*.scala' -newer "$CPFILE" 2>/dev/null | head -1)
if [ ! -f "$CPFILE" ] || [ -n "$NEWER" ]; then
  echo "compiling…" >&2
  mkdir -p "$(dirname "$CPFILE")"
  "$ROOT/bin/sbt" -batch examples/compile >/dev/null
  "$ROOT/bin/sbt" -batch --error 'export examples/Runtime/fullClasspath' 2>/dev/null \
    | tail -1 > "$CPFILE"
fi

cd "$ROOT"
exec "$JAVA_HOME/bin/java" \
  -Xmx"${BIGASTERISK_HEAP:-6g}" \
  --add-opens=java.base/java.lang=ALL-UNNAMED \
  --add-opens=java.base/java.lang.invoke=ALL-UNNAMED \
  --add-opens=java.base/java.lang.reflect=ALL-UNNAMED \
  --add-opens=java.base/java.io=ALL-UNNAMED \
  --add-opens=java.base/java.net=ALL-UNNAMED \
  --add-opens=java.base/java.nio=ALL-UNNAMED \
  --add-opens=java.base/java.util=ALL-UNNAMED \
  --add-opens=java.base/java.util.concurrent=ALL-UNNAMED \
  --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED \
  --add-opens=java.base/jdk.internal.ref=ALL-UNNAMED \
  --add-opens=java.base/sun.nio.ch=ALL-UNNAMED \
  --add-opens=java.base/sun.nio.cs=ALL-UNNAMED \
  --add-opens=java.base/sun.security.action=ALL-UNNAMED \
  --add-opens=java.base/sun.util.calendar=ALL-UNNAMED \
  -cp "$(cat "$CPFILE")" \
  "$MAIN" "$@"
